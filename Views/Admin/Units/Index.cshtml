
@model IEnumerable<Code123.Models.UnitModel>

@{
    ViewData["Title"] = "Units";
    ViewData["Active"] = "units";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";

    var groups = Model
        .GroupBy(unit => new
        {
            unit.LearningPathId,
            LearningPathTitle = unit.LearningPathsModel?.Title ?? "Unknown Learning Path"
        })
        .OrderBy(group => group.Key.LearningPathId);
}

<div class="flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold">Units</h1>
        <p class="text-sm text-stone-600">@Model.Count() records</p>
    </div>

    <button type="button"
            onclick="openCreateModal()"
            class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
        Create new
    </button>
</div>

@if (!Model.Any())
{
    <div class="mt-6 rounded-xl border border-stone-200 bg-white px-4 py-10 text-center text-stone-500">
        Nothing here yet. Create your first unit.
    </div>
}
else
{
    @foreach (var group in groups)
    {
        <section class="mt-8">
            <div class="mb-3">
                <h2 class="text-lg font-bold">
                    @group.Key.LearningPathTitle
                    <span class="text-sm font-normal text-stone-500">(Learning Path)</span>
                </h2>
            </div>

            <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white">
                <table class="min-w-full divide-y divide-stone-200 text-sm">
                    <thead class="bg-stone-50 text-left text-stone-600">
                        <tr>
                            <th class="px-4 py-3 font-semibold">Order</th>
                            <th class="px-4 py-3 font-semibold">Unit</th>
                            <th class="px-4 py-3 font-semibold">Lessons</th>
                            <th class="px-4 py-3 text-right font-semibold">Actions</th>
                        </tr>
                    </thead>

                    <tbody class="divide-y divide-stone-100">
                        @foreach (var unit in group.OrderBy(u => u.OrderIndex))
                        {
                            <tr class="hover:bg-stone-50">
                                <td class="px-4 py-3">@unit.OrderIndex</td>
                                <td class="px-4 py-3 font-medium">@unit.Title</td>
                                <td class="px-4 py-3">@unit.LessonsModel.Count</td>

                                <td class="px-4 py-3">
                                    <div class="flex justify-end gap-1">
                                        <button type="button"
                                                data-edit
                                                data-id="@unit.Id"
                                                data-learning-path-id="@unit.LearningPathId"
                                                data-title="@unit.Title"
                                                data-order="@unit.OrderIndex"
                                                class="rounded px-2 py-1 text-brand-700 hover:bg-brand-50">
                                            Edit
                                        </button>

                                        <form asp-controller="Units"
                                              asp-action="Delete"
                                              asp-route-id="@unit.Id"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this unit?');">
                                            <button type="submit"
                                                    class="rounded px-2 py-1 text-red-700 hover:bg-red-50">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

<!-- Create and Edit Modal -->
<dialog id="unitModal"
        class="w-full max-w-2xl rounded-xl border border-stone-200 bg-white p-0 shadow-xl backdrop:bg-stone-900/50">

    <div class="flex items-center justify-between border-b border-stone-200 px-6 py-4">
        <div>
            <h2 id="modalTitle" class="text-xl font-bold">Create Unit</h2>
            <p id="modalDescription" class="text-sm text-stone-600">
                Add a new unit to a learning path.
            </p>
        </div>

        <button type="button"
                onclick="closeUnitModal()"
                class="rounded-md p-2 text-stone-500 hover:bg-stone-100"
                aria-label="Close modal">
            ✕
        </button>
    </div>

    <form id="unitForm"
          action="/Units/Create"
          method="post"
          class="space-y-5 p-6">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

        <partial name="~/Views/Admin/Units/_FormFields.cshtml"
                 model="@(new Code123.Models.UnitModel())" />

        <div class="flex justify-end gap-3 border-t border-stone-100 pt-5">
            <button type="button"
                    onclick="closeUnitModal()"
                    class="rounded-md border border-stone-300 bg-white px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50">
                Cancel
            </button>

            <button id="submitButton"
                    type="submit"
                    class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
                Create Unit
            </button>
        </div>
    </form>
</dialog>

<style>
    #unitModal[open] {
        margin: auto;
    }
</style>

<script>
    const unitModal = document.getElementById('unitModal');
    const unitForm = document.getElementById('unitForm');

    function openCreateModal() {
        unitForm.reset();
        unitForm.action = '/Units/Create';

        document.getElementById('LearningPathId').value = '';
        document.getElementById('Title').value = '';
        document.getElementById('OrderIndex').value = '1';

        document.getElementById('modalTitle').textContent = 'Create Unit';
        document.getElementById('modalDescription').textContent =
            'Add a new unit to a learning path.';
        document.getElementById('submitButton').textContent = 'Create Unit';

        unitModal.showModal();
    }

    function closeUnitModal() {
        unitModal.close();
    }

    document.querySelectorAll('[data-edit]').forEach(button => {
        button.addEventListener('click', function () {
            const id = this.dataset.id;

            unitForm.action = `/Units/Edit/${id}`;

            document.getElementById('LearningPathId').value =
                this.dataset.learningPathId;
            document.getElementById('Title').value = this.dataset.title;
            document.getElementById('OrderIndex').value = this.dataset.order;

            document.getElementById('modalTitle').textContent = 'Edit Unit';
            document.getElementById('modalDescription').textContent =
                'Update the unit information.';
            document.getElementById('submitButton').textContent = 'Save Changes';

            unitModal.showModal();
        });
    });

    unitModal.addEventListener('click', function (event) {
        if (event.target === unitModal) {
            unitModal.close();
        }
    });
</script>
