
@model Code123.Models.ExerciseQuestionModel

@{
    ViewData["Title"] = "Create Exercise Question";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="mx-auto max-w-2xl">
    <h1 class="mb-6 text-2xl font-bold">Create Exercise Question</h1>

    <form asp-action="Create" method="post"
          class="space-y-5 rounded-xl border border-stone-200 bg-white p-6">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

        <partial name="~/Views/Admin/ExerciseQuestions/_FormFields.cshtml" model="Model" />

        <div class="flex justify-end gap-2">
            <a asp-action="Index"
               class="rounded-md border border-stone-300 px-4 py-2 text-sm">
                Cancel
            </a>

            <button type="submit"
                    class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white">
                Create Question
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const optionsInput = document.getElementById("optionsInput");
        const optionsJson = document.getElementById("optionsJson");
        const correctAnswerInput = document.getElementById("correctAnswerInput");

        function updateOptions() {
            const options = optionsInput.value
                .split("\n")
                .map(option => option.trim())
                .filter(option => option.length > 0);

            optionsJson.value = JSON.stringify(options);

            correctAnswerInput.innerHTML =
                '<option value="">Select the correct answer</option>';

            options.forEach(option => {
                const element = document.createElement("option");
                element.value = option;
                element.textContent = option;
                correctAnswerInput.appendChild(element);
            });
        }

        optionsInput.addEventListener("input", updateOptions);
        updateOptions();
    </script>
}
