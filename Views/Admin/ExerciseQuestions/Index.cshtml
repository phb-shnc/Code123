
@model IEnumerable<Code123.Models.ExerciseQuestionModel>

@{
    ViewData["Title"] = "Exercise Questions";
    ViewData["Active"] = "exercises";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";

    var groups = Model
        .GroupBy(question => new
        {
            LearningPathId = question.LessonsModel?.UnitsModel?.LearningPathId ?? 0,
            LearningPathTitle = question.LessonsModel?.UnitsModel?.LearningPathsModel?.Title ?? "Unknown Learning Path"
        })
        .OrderBy(group => group.Key.LearningPathId);
}

<div class="flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold">Exercise Questions</h1>
        <p class="text-sm text-stone-600">@Model.Count() records</p>
    </div>

    <button type="button"
            onclick="openCreateModal()"
            class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
        Create new
    </button>
</div>

@if (!Model.Any())
{
    <div class="mt-6 rounded-xl border border-stone-200 bg-white px-4 py-10 text-center text-stone-500">
        Nothing here yet. Create your first exercise question.
    </div>
}
else
{
    @foreach (var pathGroup in groups)
    {
        <section class="mt-8">
            <h2 class="mb-4 text-lg font-bold">
                @pathGroup.Key.LearningPathTitle
                <span class="text-sm font-normal text-stone-500">(Learning Path)</span>
            </h2>

            @{
                var unitGroups = pathGroup
                    .GroupBy(question => new
                    {
                        UnitId = question.LessonsModel?.UnitId ?? 0,
                        UnitTitle = question.LessonsModel?.UnitsModel?.Title ?? "Unknown Unit"
                    })
                    .OrderBy(group => group.Key.UnitId);
            }

            @foreach (var unitGroup in unitGroups)
            {
                <div class="mb-6 ml-4">
                    <h3 class="mb-3 text-base font-semibold">
                        @unitGroup.Key.UnitTitle
                        <span class="text-sm font-normal text-stone-500">(Unit)</span>
                    </h3>

                    @{
                        var lessonGroups = unitGroup
                            .GroupBy(question => new
                            {
                                LessonId = question.LessonId,
                                LessonTitle = question.LessonsModel?.Title ?? "Unknown Lesson"
                            })
                            .OrderBy(group => group.Key.LessonId);
                    }

                    @foreach (var lessonGroup in lessonGroups)
                    {
                        <div class="mb-5 ml-4">
                            <h4 class="mb-3 text-sm font-semibold text-stone-700">
                                @lessonGroup.Key.LessonTitle
                                <span class="font-normal text-stone-500">(Lesson)</span>
                            </h4>

                            <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white">
                                <table class="min-w-full divide-y divide-stone-200 text-sm">
                                    <thead class="bg-stone-50 text-left text-stone-600">
                                        <tr>
                                            <th class="px-4 py-3 font-semibold">Question</th>
                                            <th class="px-4 py-3 font-semibold">Options</th>
                                            <th class="px-4 py-3 font-semibold">Correct Answer</th>
                                            <th class="px-4 py-3 text-right font-semibold">Actions</th>
                                        </tr>
                                    </thead>

                                    <tbody class="divide-y divide-stone-100">
                                        @foreach (var question in lessonGroup)
                                        {
                                            var optionCount = 0;

                                            try
                                            {
                                                optionCount = System.Text.Json.JsonSerializer
                                                    .Deserialize<string[]>(question.Options)?.Length ?? 0;
                                            }
                                            catch
                                            {
                                                optionCount = 0;
                                            }

                                            <tr class="hover:bg-stone-50">
                                                <td class="max-w-md px-4 py-3 font-medium">
                                                    @question.QuestionText
                                                </td>
                                                <td class="px-4 py-3">@optionCount</td>
                                                <td class="px-4 py-3">@question.CorrectAnswer</td>

                                                <td class="px-4 py-3">
                                                    <div class="flex justify-end gap-1">
                                                        <button type="button"
                                                                data-edit
                                                                data-id="@question.Id"
                                                                data-lesson-id="@question.LessonId"
                                                                data-question="@question.QuestionText"
                                                                data-options="@question.Options"
                                                                data-correct-answer="@question.CorrectAnswer"
                                                                class="rounded px-2 py-1 text-brand-700 hover:bg-brand-50">
                                                            Edit
                                                        </button>

                                                       <button type="button"
                                                       data-delete-url="@Url.Action("Delete", "ExerciseQuestions", new { area = "Admin", id = question.Id })"
                                                       data-delete-name="@question.QuestionText"
                                                       class="rounded px-2 py-1 text-red-700 hover:bg-red-50">
                                                       Delete
                                                       </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>
    }
}


<dialog id="questionModal" class="w-full max-w-2xl rounded-xl p-0 shadow-xl backdrop:bg-black/40">
    <form id="questionForm"
          method="post"
          action="@Url.Action("Create", "ExerciseQuestions", new { area = "Admin" })"
          class="p-6">
        @Html.AntiForgeryToken()

        <div class="mb-5 flex items-center justify-between">
            <h2 id="questionModalTitle" class="text-xl font-bold">Create Exercise Question</h2>

            <button type="button"
                    onclick="closeQuestionModal()"
                    class="rounded px-2 py-1 text-stone-500 hover:bg-stone-100">
                ✕
            </button>
        </div>

        <partial name="~/Views/Admin/ExerciseQuestions/_FormFields.cshtml"
                 model="@(new Code123.Models.ExerciseQuestionModel())" />

        <div class="mt-6 flex justify-end gap-2">
            <button type="button"
                    onclick="closeQuestionModal()"
                    class="rounded-md border border-stone-300 px-4 py-2 text-sm">
                Cancel
            </button>

            <button type="submit"
                    class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
                Save Question
            </button>
        </div>
    </form>
</dialog>

<style>
    #questionModal[open] {
        margin: auto;
    }
</style>

<script>
    const questionModal = document.getElementById("questionModal");
    const questionForm = document.getElementById("questionForm");

    // Area-aware URLs generated by MVC (no hard-coded paths)
    const createUrl = '@Url.Action("Create", "ExerciseQuestions", new { area = "Admin" })';
    const editBaseUrl = '@Url.Action("Edit", "ExerciseQuestions", new { area = "Admin" })';

    const optionsInput = document.getElementById("optionsInput");
    const optionsJson = document.getElementById("optionsJson");
    const correctAnswerInput = document.getElementById("correctAnswerInput");

    function getOptions() {
        return optionsInput.value
            .split("\n")
            .map(option => option.trim())
            .filter(option => option.length > 0);
    }

    function updateOptions() {
        const options = getOptions();
        const previousAnswer = correctAnswerInput.value;

        optionsJson.value = JSON.stringify(options);

        correctAnswerInput.innerHTML =
            '<option value="">Select the correct answer</option>';

        options.forEach(option => {
            const optionElement = document.createElement("option");
            optionElement.value = option;
            optionElement.textContent = option;
            correctAnswerInput.appendChild(optionElement);
        });

        if (options.includes(previousAnswer)) {
            correctAnswerInput.value = previousAnswer;
        }
    }

    optionsInput.addEventListener("input", updateOptions);

    function openCreateModal() {
        questionForm.action = createUrl;
        questionForm.reset();

        document.getElementById("questionModalTitle").textContent =
            "Create Exercise Question";

        optionsInput.value = "";
        optionsJson.value = "[]";
        correctAnswerInput.innerHTML =
            '<option value="">Select the correct answer</option>';

        questionModal.showModal();
    }

    function closeQuestionModal() {
        questionModal.close();
    }

    document.querySelectorAll("[data-edit]").forEach(button => {
        button.addEventListener("click", () => {
            const id = button.dataset.id;

            questionForm.action = `${editBaseUrl}/${id}`;

            document.getElementById("questionModalTitle").textContent =
                "Edit Exercise Question";

            questionForm.querySelector('[name="LessonId"]').value =
                button.dataset.lessonId;

            questionForm.querySelector('[name="QuestionText"]').value =
                button.dataset.question;

            let savedOptions = [];
            try {
                savedOptions = JSON.parse(button.dataset.options || "[]");
            } catch {
                savedOptions = [];
            }

            optionsInput.value = savedOptions.join("\n");
            updateOptions();

            correctAnswerInput.value = button.dataset.correctAnswer;

            questionModal.showModal();
        });
    });

    questionForm.addEventListener("submit", () => {
        updateOptions();
    });

    questionModal.addEventListener("click", event => {
        if (event.target === questionModal) {
            questionModal.close();
        }
    });
</script>
