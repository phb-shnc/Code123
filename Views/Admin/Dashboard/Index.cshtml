
@model Code123.Controllers.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["Active"] = "dashboard";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";

    var modules = new (string Label, int Count, string Href, string Hint)[]
    {
        ("Learning paths", Model.LearningPaths, "/admin-preview/learning-paths", "Courses learners can follow"),
        ("Units", Model.Units, "#", "Sections inside a path"),
        ("Lessons", Model.Lessons, "#", "Individual lesson pages"),
        ("Exercises & questions", Model.Questions, "#", "Practice and quiz items"),
        ("Users", Model.Users, "#", "Learners and admins"),
    };
}

<section class="rounded-xl border border-stone-200 bg-white p-6 sm:p-8">
    <h1 class="text-2xl font-bold">Welcome back</h1>
    <p class="mt-1 max-w-prose text-stone-600">
        Pick a module to review content, or start something new.
    </p>

    <div class="mt-5 flex flex-wrap gap-3">
        <a href="/admin-preview/learning-paths/create"
           class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
            New learning path
        </a>

        <a href="#"
           class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50">
            Browse lessons
        </a>
    </div>
</section>

<section class="mt-8" aria-labelledby="overview">
    <h2 id="overview" class="text-lg font-semibold">Content overview</h2>

    <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var m in modules)
        {
            <a href="@m.Href"
               class="rounded-xl border border-stone-200 bg-white p-5 hover:border-brand-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600">

                <p class="text-sm text-stone-600">@m.Label</p>
                <p class="mt-1 text-3xl font-bold">@m.Count.ToString("N0")</p>
                <p class="mt-2 text-sm text-stone-500">@m.Hint</p>
            </a>
        }
    </div>
</section>

<section class="mt-8" aria-labelledby="recent-users">
    <h2 id="recent-users" class="text-lg font-semibold">Recent users</h2>

    <div class="mt-3 overflow-x-auto rounded-xl border border-stone-200 bg-white">
        <table class="min-w-full text-left text-sm">
            <thead class="border-b border-stone-200 bg-stone-50 text-stone-600">
                <tr>
                    <th scope="col" class="px-4 py-3 font-medium">Name</th>
                    <th scope="col" class="px-4 py-3 font-medium">Username</th>
                    <th scope="col" class="px-4 py-3 font-medium">Email</th>
                    <th scope="col" class="px-4 py-3 font-medium">Roles</th>
                    <th scope="col" class="px-4 py-3 font-medium">Joined (UTC)</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-stone-100">
                @foreach (var u in Model.RecentUsers)
                {
                    <tr>
                        <td class="px-4 py-3 font-medium">@u.Name</td>
                        <td class="px-4 py-3 text-stone-600">@u.Username</td>
                        <td class="px-4 py-3 text-stone-600">@u.Email</td>
                        <td class="px-4 py-3 text-stone-600">@u.Roles</td>
                        <td class="px-4 py-3 text-stone-600">@u.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    </tr>
                }

                @if (!Model.RecentUsers.Any())
                {
                    <tr>
                        <td colspan="5" class="px-4 py-6 text-center text-stone-500">No users yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>