<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Admin") - Code123 Admin</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['"Hanken Grotesk"', 'system-ui', 'sans-serif'] },
                    colors: {
                        brand: { 50: '#eef7f5', 100: '#d5ece7', 600: '#1f7a6d', 700: '#17625a', 800: '#124d47' }
                    }
                }
            }
        }
    </script>
    <style>
        .input-validation-error { border-color: #b91c1c; background-color: #fef2f2; }
    </style>
</head>
<body class="min-h-screen bg-stone-50 font-sans text-stone-800 antialiased">

    <header class="flex items-center justify-between border-b border-stone-200 bg-white px-4 py-3 md:hidden">
        <span class="font-semibold">Code123 Admin</span>
        <button type="button" id="navToggle" aria-label="Toggle navigation" aria-controls="sidebar"
                class="rounded-md p-2 text-stone-600 hover:bg-stone-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" /></svg>
        </button>
    </header>

    <aside id="sidebar" class="fixed inset-y-0 left-0 z-30 flex w-64 -translate-x-full flex-col border-r border-stone-200 bg-white transition-transform md:translate-x-0">
        <div class="px-6 py-5 text-lg font-bold text-brand-800 flex items-center justify-between">
            <span>Code123 Admin</span>
        </div>
        
        <!-- Quick Navigation / Role Hub Links -->
        <div class="px-4 py-2 border-b border-stone-100 text-xs text-stone-500 font-medium">
            <a asp-controller="Home" asp-action="Index" class="block py-1 hover:text-brand-700">← Back to Home Hub</a>
            <a asp-area="Student" asp-controller="Dashboard" asp-action="Index" class="block py-1 hover:text-brand-700">Switch to Student Dashboard</a>
        </div>

        <nav class="flex-1 space-y-1 px-3 mt-2" aria-label="Admin modules">
            @foreach (var n in nav)
            {
                <a href="@n.Href"
                   class="flex items-center gap-3 rounded-md px-3 py-2 text-sm @(active == n.Key ? "bg-brand-50 font-semibold text-brand-800" : "text-stone-600 hover:bg-stone-100")"
                   aria-current="@(active == n.Key ? "page" : null)">
                    <svg class="h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="@n.Icon" /></svg>
                    @n.Label
                </a>
            }
        </nav>
        
        <!-- Logout action at the bottom of the sidebar -->
        <div class="p-4 border-t border-stone-200">
            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                <button type="submit" class="w-full text-left text-sm text-stone-600 hover:text-red-600 px-3 py-2 rounded-md hover:bg-stone-100">
                    Log out
                </button>
            </form>
        </div>
    </aside>

    <main class="md:pl-64">
        <div class="mx-auto max-w-6xl px-4 py-8 sm:px-8">
            <partial name="~/Views/Admin/Shared/_Alerts.cshtml" />
            @RenderBody()
        </div>
    </main>

    <partial name="~/Views/Admin/Shared/_DeleteModal.cshtml" />

    <script>
        document.getElementById('navToggle').addEventListener('click', function () {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>