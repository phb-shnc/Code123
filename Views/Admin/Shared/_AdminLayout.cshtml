
@{
    var path = Context.Request.Path.Value?.TrimEnd('/').ToLowerInvariant() ?? "";

    var active = ViewData["Active"] as string ?? "";

    if (path.StartsWith("/admin/dashboard") || path == "/admin")
        active = "dashboard";
    else if (path.StartsWith("/admin/learningpaths"))
        active = "paths";
    else if (path.StartsWith("/admin/units"))
        active = "units";
    else if (path.StartsWith("/admin/lessons"))
        active = "lessons";
    else if (path.StartsWith("/admin/exercisequestions"))
        active = "exercises";
    else if (path.StartsWith("/admin/users"))
        active = "users";

    var nav = new (string Key, string Label, string Href, string Icon)[]
    {
        ("dashboard", "Dashboard", Url.Action("Index", "Dashboard", new { area = "Admin" }) ?? "/Admin/Dashboard", "M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"),
