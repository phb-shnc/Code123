
@model IEnumerable<Code123.Models.LessonModel>

@{
    ViewData["Title"] = "Lessons";
    ViewData["Active"] = "lessons";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";

    var groups = Model
        .GroupBy(lesson => new
        {
            LearningPathId = lesson.UnitsModel?.LearningPathId ?? 0,
            LearningPathTitle = lesson.UnitsModel?.LearningPathsModel?.Title ?? "Unknown Learning Path"
        })
        .OrderBy(group => group.Key.LearningPathId);
}

<div class="flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold">Lessons</h1>
        <p class="text-sm text-stone-600">@Model.Count() records</p>
    </div>

    <button type="button"
            onclick="openCreateModal()"
            class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
        Create new
    </button>
</div>

@if (!Model.Any())
{
    <div class="mt-6 rounded-xl border border-stone-200 bg-white px-4 py-10 text-center text-stone-500">
        Nothing here yet. Create your first lesson.
    </div>
}
else
{
    @foreach (var pathGroup in groups)
    {
        <section class="mt-8">
            <h2 class="mb-4 text-lg font-bold">
                @pathGroup.Key.LearningPathTitle
                <span class="text-sm font-normal text-stone-500">(Learning Path)</span>
            </h2>

            @{
                var unitGroups = pathGroup
                    .GroupBy(lesson => new
                    {
                        UnitId = lesson.UnitId,
                        UnitTitle = lesson.UnitsModel?.Title ?? "Unknown Unit"
                    })
                    .OrderBy(group => group.Key.UnitId);
            }

            @foreach (var unitGroup in unitGroups)
            {
                <div class="mb-6 ml-4">
                    <h3 class="mb-3 text-base font-semibold">
                        @unitGroup.Key.UnitTitle
                        <span class="text-sm font-normal text-stone-500">(Unit)</span>
                    </h3>

                    <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white">
                        <table class="min-w-full divide-y divide-stone-200 text-sm">
                            <thead class="bg-stone-50 text-left text-stone-600">
                                <tr>
                                    <th class="px-4 py-3 font-semibold">Lesson</th>
                                    <th class="px-4 py-3 font-semibold">Exercise Questions</th>
                                    <th class="px-4 py-3 text-right font-semibold">Actions</th>
                                </tr>
                            </thead>

                            <tbody class="divide-y divide-stone-100">
                                @foreach (var lesson in unitGroup.OrderBy(l => l.Id))
                                {
                                    <tr class="hover:bg-stone-50">
                                        <td class="px-4 py-3 font-medium">@lesson.Title</td>
                                        <td class="px-4 py-3">@lesson.ExerciseQuestions.Count</td>

                                        <td class="px-4 py-3">
                                            <div class="flex justify-end gap-1">
                                                <button type="button"
                                                        data-edit
                                                        data-id="@lesson.Id"
                                                        data-unit-id="@lesson.UnitId"
                                                        data-title="@lesson.Title"
                                                        data-content="@lesson.Content"
                                                        class="rounded px-2 py-1 text-brand-700 hover:bg-brand-50">
                                                    Edit
                                                </button>

                                                <button type="button"
                                                data-delete-url="@Url.Action("Delete", "Lessons", new { area = "Admin", id = lesson.Id })"
                                                data-delete-name="@lesson.Title"
                                                class="rounded px-2 py-1 text-red-700 hover:bg-red-50">
                                                Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </section>
    }
}


<dialog id="lessonModal" class="w-full max-w-2xl rounded-xl p-0 shadow-xl backdrop:bg-black/40">
    <form id="lessonForm"
          method="post"
          action="@Url.Action("Create", "Lessons", new { area = "Admin" })"
          class="p-6">
        @Html.AntiForgeryToken()

        <div class="mb-5 flex items-center justify-between">
            <h2 id="lessonModalTitle" class="text-xl font-bold">Create Lesson</h2>
            <button type="button"
                    onclick="closeLessonModal()"
                    class="rounded px-2 py-1 text-stone-500 hover:bg-stone-100">
                ✕
            </button>
        </div>

        <partial name="~/Views/Admin/Lessons/_FormFields.cshtml"
                 model="@(new Code123.Models.LessonModel())" />

        <div class="mt-6 flex justify-end gap-2">
            <button type="button"
                    onclick="closeLessonModal()"
                    class="rounded-md border border-stone-300 px-4 py-2 text-sm">
                Cancel
            </button>

            <button type="submit"
                    class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
                Save Lesson
            </button>
        </div>
    </form>
</dialog>

<style>
    #lessonModal[open] {
        margin: auto;
    }
</style>

<script>
    const lessonModal = document.getElementById("lessonModal");
    const lessonForm = document.getElementById("lessonForm");

    // Area-aware URLs generated by MVC (no hard-coded paths)
    const createUrl = '@Url.Action("Create", "Lessons", new { area = "Admin" })';
    const editBaseUrl = '@Url.Action("Edit", "Lessons", new { area = "Admin" })';

    function openCreateModal() {
        lessonForm.action = createUrl;
        lessonForm.reset();

        document.getElementById("lessonModalTitle").textContent = "Create Lesson";

        lessonModal.showModal();
    }

    function closeLessonModal() {
        lessonModal.close();
    }

    document.querySelectorAll("[data-edit]").forEach(button => {
        button.addEventListener("click", () => {
            const id = button.dataset.id;

            lessonForm.action = `${editBaseUrl}/${id}`;

            document.getElementById("lessonModalTitle").textContent = "Edit Lesson";

            lessonForm.querySelector('[name="UnitId"]').value = button.dataset.unitId;
            lessonForm.querySelector('[name="Title"]').value = button.dataset.title;
            lessonForm.querySelector('[name="Content"]').value = button.dataset.content;

            lessonModal.showModal();
        });
    });

    lessonModal.addEventListener("click", event => {
        if (event.target === lessonModal) {
            lessonModal.close();
        }
    });
</script>
