
@model Code123.Models.UserModel

@{
    ViewData["Title"] = "Create User";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";
}

<div class="mx-auto max-w-xl">
    <h1 class="mb-6 text-2xl font-bold">Create User</h1>

    <form asp-action="Create" method="post"
          class="space-y-5 rounded-xl border border-stone-200 bg-white p-6">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="text-sm text-red-600"></div>

        <partial name="~/Views/Admin/Users/_FormFields.cshtml" model="Model" />

        <div class="flex justify-end gap-2">
            <a asp-action="Index"
               class="rounded-md border border-stone-300 px-4 py-2 text-sm">
                Cancel
            </a>

            <button type="submit"
                    class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white">
                Create User
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
