
@model IEnumerable<Code123.Models.UserModel>

@{
    ViewData["Title"] = "Users";
    ViewData["Active"] = "users";
    Layout = "~/Views/Admin/Shared/_AdminLayout.cshtml";

    var admins = Model.Where(user => user.Role == Code123.Models.UserRoles.Admin).ToList();
    var students = Model.Where(user => user.Role == Code123.Models.UserRoles.Student).ToList();
}

<div class="flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold">Users</h1>
        <p class="text-sm text-stone-600">@Model.Count() accounts</p>
    </div>

    <button type="button"
            onclick="openCreateModal()"
            class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
        Create new
    </button>
</div>

<!-- Admin Accounts -->
<section class="mt-8">
    <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-bold">Admins</h2>
        <span class="text-sm text-stone-500">@admins.Count accounts</span>
    </div>

    <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white">
        <table class="min-w-full divide-y divide-stone-200 text-sm">
            <thead class="bg-stone-50 text-left text-stone-600">
                <tr>
                    <th class="px-4 py-3 font-semibold">Name</th>
                    <th class="px-4 py-3 font-semibold">Email</th>
                    <th class="px-4 py-3 text-right font-semibold">Actions</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-stone-100">
                @if (!admins.Any())
                {
                    <tr>
                        <td colspan="3" class="px-4 py-6 text-center text-stone-500">
                            No Admin accounts found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in admins)
                    {
                        <tr class="hover:bg-stone-50">
                            <td class="px-4 py-3 font-medium">@user.Name</td>
                            <td class="px-4 py-3">@user.Email</td>
                            <td class="px-4 py-3">
                                <div class="flex justify-end gap-1">
                                    <button type="button"
                                            data-edit
                                            data-id="@user.Id"
                                            data-name="@user.Name"
                                            data-email="@user.Email"
                                            data-role="@user.Role"
                                            class="rounded px-2 py-1 text-brand-700 hover:bg-brand-50">
                                        Edit
                                    </button>

                                    <form asp-controller="Users"
                                          asp-action="Delete"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this Admin account?');">
                                        <button type="submit"
                                                class="rounded px-2 py-1 text-red-700 hover:bg-red-50">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

<!-- Student Accounts -->
<section class="mt-8">
    <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-bold">Students</h2>
        <span class="text-sm text-stone-500">@students.Count accounts</span>
    </div>

    <div class="overflow-x-auto rounded-xl border border-stone-200 bg-white">
        <table class="min-w-full divide-y divide-stone-200 text-sm">
            <thead class="bg-stone-50 text-left text-stone-600">
                <tr>
                    <th class="px-4 py-3 font-semibold">Name</th>
                    <th class="px-4 py-3 font-semibold">Email</th>
                    <th class="px-4 py-3 text-right font-semibold">Actions</th>
                </tr>
            </thead>

            <tbody class="divide-y divide-stone-100">
                @if (!students.Any())
                {
                    <tr>
                        <td colspan="3" class="px-4 py-6 text-center text-stone-500">
                            No Student accounts found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in students)
                    {
                        <tr class="hover:bg-stone-50">
                            <td class="px-4 py-3 font-medium">@user.Name</td>
                            <td class="px-4 py-3">@user.Email</td>
                            <td class="px-4 py-3">
                                <div class="flex justify-end gap-1">
                                    <button type="button"
                                            data-edit
                                            data-id="@user.Id"
                                            data-name="@user.Name"
                                            data-email="@user.Email"
                                            data-role="@user.Role"
                                            class="rounded px-2 py-1 text-brand-700 hover:bg-brand-50">
                                        Edit
                                    </button>

                                    <form asp-controller="Users"
                                          asp-action="Delete"
                                          asp-route-id="@user.Id"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this Student account?');">
                                        <button type="submit"
                                                class="rounded px-2 py-1 text-red-700 hover:bg-red-50">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>


<dialog id="userModal" class="w-full max-w-xl rounded-xl p-0 shadow-xl backdrop:bg-black/40">
    <form id="userForm" method="post" action="/Users/Create" class="p-6">
        @Html.AntiForgeryToken()

        <div class="mb-5 flex items-center justify-between">
            <h2 id="userModalTitle" class="text-xl font-bold">Create User</h2>

            <button type="button"
                    onclick="closeUserModal()"
                    class="rounded px-2 py-1 text-stone-500 hover:bg-stone-100">
                ✕
            </button>
        </div>

        <partial name="~/Views/Admin/Users/_FormFields.cshtml"
                 model="@(new Code123.Models.UserModel())" />

        <div class="mt-6 flex justify-end gap-2">
            <button type="button"
                    onclick="closeUserModal()"
                    class="rounded-md border border-stone-300 px-4 py-2 text-sm">
                Cancel
            </button>

            <button type="submit"
                    class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800">
                Save User
            </button>
        </div>
    </form>
</dialog>

<script>
    const userModal = document.getElementById("userModal");
    const userForm = document.getElementById("userForm");

    const passwordInput = userForm.querySelector('[name="Password"]');
    const passwordHint = document.getElementById("passwordHint");

    function openCreateModal() {
        userForm.action = "/Users/Create";
        userForm.reset();

        document.getElementById("userModalTitle").textContent = "Create User";

        passwordInput.required = true;
        passwordInput.placeholder = "Enter password";
        passwordHint.textContent = "Password is required and must contain at least 8 characters.";

        userModal.showModal();
    }

    function closeUserModal() {
        userModal.close();
    }

    document.querySelectorAll("[data-edit]").forEach(button => {
        button.addEventListener("click", () => {
            const id = button.dataset.id;

            userForm.action = `/Users/Edit/${id}`;
            userForm.reset();

            document.getElementById("userModalTitle").textContent = "Edit User";

            userForm.querySelector('[name="Name"]').value = button.dataset.name;
            userForm.querySelector('[name="Email"]').value = button.dataset.email;
            userForm.querySelector('[name="Role"]').value = button.dataset.role;

            passwordInput.value = "";
            passwordInput.required = false;
            passwordInput.placeholder = "Leave blank to keep current password";
            passwordHint.textContent = "Leave blank if you do not want to change the password.";

            userModal.showModal();
        });
    });
</script>
