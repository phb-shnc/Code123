@*
    List / Index template. Copy to Views/<Module>/Index.cshtml, add @model IEnumerable<YourEntity>,
    and replace the sample "rows" with @foreach (var item in Model) { ... }.
*@
@{
    ViewData["Title"] = "Learning paths";
    ViewData["Active"] = "paths";
    Layout = "_AdminLayout";

    // Sample data for preview only.
    var rows = new (int Id, string Title, string Details)[]
    {
        (1, "Web development basics", "3 units, 14 lessons"),
        (2, "C# fundamentals", "5 units, 32 lessons"),
        (3, "SQL for beginners", "2 units, 9 lessons"),
    };
}

<div class="flex flex-wrap items-center justify-between gap-4">
    <div>
        <h1 class="text-2xl font-bold">Learning paths</h1>
        <p class="text-sm text-stone-600">@rows.Length records</p>
    </div>
    <a href="/admin/learning-paths/create"
       class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2">
        Create new
    </a>
</div>

<div class="mt-6 overflow-x-auto rounded-xl border border-stone-200 bg-white">
    <table class="min-w-full divide-y divide-stone-200 text-sm">
        <thead class="bg-stone-50 text-left text-stone-600">
            <tr>
                <th scope="col" class="px-4 py-3 font-semibold">ID</th>
                <th scope="col" class="px-4 py-3 font-semibold">Title</th>
                <th scope="col" class="hidden px-4 py-3 font-semibold md:table-cell">Details</th>
                <th scope="col" class="px-4 py-3 text-right font-semibold">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-stone-100">
            @foreach (var r in rows)
            {
                <tr class="hover:bg-stone-50">
                    <td class="px-4 py-3 text-stone-500">@r.Id</td>
                    <td class="px-4 py-3 font-medium">@r.Title</td>
                    <td class="hidden px-4 py-3 text-stone-600 md:table-cell">@r.Details</td>
                    <td class="px-4 py-3">
                        <div class="flex justify-end gap-1">
                            <a href="/admin/learning-paths/details/@r.Id" class="rounded px-2 py-1 text-stone-700 hover:bg-stone-100">View</a>
                            <a href="/admin/learning-paths/edit/@r.Id" class="rounded px-2 py-1 text-brand-700 hover:bg-brand-50">Edit</a>
                            <button type="button"
                                    data-delete-url="/admin/learning-paths/delete/@r.Id"
                                    data-delete-name="@r.Title"
                                    class="rounded px-2 py-1 text-red-700 hover:bg-red-50">Delete</button>
                        </div>
                    </td>
                </tr>
            }
            @if (rows.Length == 0)
            {
                <tr>
                    <td colspan="4" class="px-4 py-10 text-center text-stone-500">
                        Nothing here yet. <a href="/admin/learning-paths/create" class="font-medium text-brand-700 hover:underline">Create the first learning path.</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
