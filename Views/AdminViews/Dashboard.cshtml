@{
    ViewData["Title"] = "Dashboard";
    ViewData["Active"] = "dashboard";
    Layout = "~/Views/AdminViews/_AdminLayout.cshtml";

    // Sample numbers. Replace with real counts from your controller.
    var modules = new (string Label, int Count, string Href, string Hint)[]
    {
        ("Learning paths", 6, "/admin-preview/learning-paths", "Courses learners can follow"),
        ("Units", 24, "#", "Sections inside a path"),
        ("Lessons", 118, "#", "Individual lesson pages"),
        ("Exercises & questions", 342, "#", "Practice and quiz items"),
        ("Users", 1280, "#", "Learners and admins"),
    };
}

<section class="rounded-xl border border-stone-200 bg-white p-6 sm:p-8">
    <h1 class="text-2xl font-bold">Welcome back</h1>
    <p class="mt-1 max-w-prose text-stone-600">Pick a module to review content, or start something new.</p>
    <div class="mt-5 flex flex-wrap gap-3">
        <a href="/admin-preview/learning-paths/create" class="rounded-md bg-brand-700 px-4 py-2 text-sm font-medium text-white hover:bg-brand-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2">New learning path</a>
        <a href="#" class="rounded-md border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 hover:bg-stone-50">Browse lessons</a>
    </div>
</section>

<section class="mt-8" aria-labelledby="overview">
    <h2 id="overview" class="text-lg font-semibold">Content overview</h2>
    <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var m in modules)
        {
            <a href="@m.Href" class="rounded-xl border border-stone-200 bg-white p-5 hover:border-brand-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-600">
                <p class="text-sm text-stone-600">@m.Label</p>
                <p class="mt-1 text-3xl font-bold">@m.Count.ToString("N0")</p>
                <p class="mt-2 text-sm text-stone-500">@m.Hint</p>
            </a>
        }
    </div>
</section>
